      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": {
        "text": "Submodule 3:\nDuplicate Detection\n& Review\n\nControllers/\nServices/\nDTOs/\nViews/\nHandlers/\n\n~1,200 LOC\nResponsibility:\nDetect Duplicates →\nFuzzy Matching →\nReview Workflow",
        "fontSize": 12,
        "fontFamily": 1,
        "textAlign": "center",
        "verticalAlign": "middle",
        "baseline": 120
      }
    },
