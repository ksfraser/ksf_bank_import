      "seed": 40003,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": {
        "text": "Shared/\n├─ Models/ (BiTransaction, BiLineItem, BiStatement, etc.)\n├─ DTOs/  (TransactionDTO, StatementDTO, etc.)\n├─ Database/ (Repositories, Migrations)\n├─ Config/ & Exceptions/",
        "fontSize": 13,
        "fontFamily": 1,
        "textAlign": "left",
        "verticalAlign": "middle",
        "baseline": 40
      }
    },
    {
      "type": "rectangle",
      "x": 50,
      "y": 420,
      "width": 200,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1f77b4",
      "backgroundColor": "#e3f2fd",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 40004,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": {
        "text": "Submodule 1:\nImport Pipeline\n\nControllers/\nHandlers/\nServices/\nViews/\nParsers/\n\n~1,200 LOC\nResponsibility:\nFile Upload → Parse →\nValidate → Transform →\nReview Staging",
        "fontSize": 12,
        "fontFamily": 1,
        "textAlign": "center",
        "verticalAlign": "middle",
        "baseline": 120
      }
    },
    {
      "type": "rectangle",
      "x": 275,
      "y": 420,
      "width": 200,
      "height": 300,
      "angle": 0,
      "strokeColor": "#d62728",
      "backgroundColor": "#ffebee",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 40005,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": {
        "text": "Submodule 2:\nTransaction\nProcessing\n\nControllers/\nActions/\nDispatcher/\nProcessors/\nViews/\n\n~1,000 LOC\nResponsibility:\nRoute Transactions →\nPartner-Specific\nProcessing → Results",
        "fontSize": 12,
        "fontFamily": 1,
        "textAlign": "center",
        "verticalAlign": "middle",
        "baseline": 120
      }
    },
    {
      "type": "rectangle",
