      "updated": 1,
      "link": null,
      "locked": false,
      "text": {
        "text": "Submodule 4:\nAdministration &\nConfiguration\n\nControllers/\nServices/\nViews/\n\n~600 LOC\nResponsibility:\nParser Config →\nTransfer Rules →\nSettings Mgmt",
        "fontSize": 12,
        "fontFamily": 1,
        "textAlign": "center",
        "verticalAlign": "middle",
