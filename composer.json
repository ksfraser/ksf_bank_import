{
    "name": "ksfraser/fa-bank-import",
    "description": "A FrontAccounting module for bank import functionality with paired transfer processing.",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Models\\": "Models/",
            "KsfBankImport\\Services\\": "Services/",
            "KsfBankImport\\OperationTypes\\": "OperationTypes/",
            "Ksfraser\\": "src/Ksfraser/"
        },
        "classmap": [
            "src/Ksfraser/FaBankImport/class.AbstractQfxParser.php",
            "src/Ksfraser/FaBankImport/header_table.php",
            "src/Ksfraser/HTML/HtmlAttributesTrait.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Ksfraser\\FaBankImport\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=7.3",
        "asgrim/ofxparser": "^1.2",
        "mimographix/qif-library": "^1.0",
        "nesbot/carbon": "^2.46",
        "psr/container": "^1.0",
        "monolog/monolog": "^2.0",
        "ksfraser/ksf-common-db": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.3",
        "codeception/codeception": "^4.1",
        "mikey179/vfsstream": "^1.6.12",
        "ksfraser/famock": "^0.10"
    },
    "scripts": {
        "test": "phpunit",
        "test-file": "phpunit",
        "post-install-cmd": [
            "@php -r \"echo '\\n\u2705 Dependencies installed successfully!\\n\\n';\""
        ],
        "post-update-cmd": [
            "@php -r \"echo '\\n\u2705 Dependencies updated successfully!\\n\\n';\""
        ]
    },
    "config": {
        "platform": {
            "php": "7.3"
        }
    }
}
